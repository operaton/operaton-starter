{
  "name": "starter-web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test:unit": "vitest run",
    "generate:api": "echo 'API types are in src/generated/'"
  },
  "dependencies": {
    "bpmn-js": "^18.31.1",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
